// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Enums
// ==========================================

enum UserStatus {
  ACTIVE
  BANNED
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PlayerType {
  FIDE // Registered with FIDE ID and official rating
  NATIONAL // Registered with National Federation only (No FIDE)
  UNRATED // Casual / Unrated player without formal affiliation
}

enum PlayerTitle {
  // Open / General Titles (FIDE)
  GM // Grandmaster
  IM // International Master
  FM // FIDE Master
  CM // Candidate Master

  // Women's Titles (FIDE)
  WGM // Woman Grandmaster
  WIM // Woman International Master
  WFM // Woman FIDE Master
  WCM // Woman Candidate Master

  // National Titles
  NM // National Master
  WNM // Woman National Master
}

enum TimeControlCategory {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
}

enum LanguageDirection {
  LTR
  RTL
}

enum TerminationReason {
  MANUAL
  SUPERSEDED
  FORCE_LOGOUT
  EXPIRED
  PASSWORD_CHANGED
}

enum GenderPolicy {
  MALE_ONLY
  FEMALE_ONLY
  BOTH
}

enum OtpType {
  PHONE_NUMBER
  EMAIL
  PREDEFINED_USER
}

enum OtpTarget {
  REGISTRATION
  RESET_PASSWORD
  FORGET_PASSWORD
  MFA
  LOGIN_NEW_DEVICE
}

enum AuthProvider {
  GOOGLE
  APPLE
  LOCAL
}

enum DeviceType {
  MOBILE
  LAPTOP
  PC
  TABLET
}

enum TournamentRole {
  ORGANIZER
  CHIEF_ARBITER
  ARBITER
  PLAYER
  SPECTATOR
}

// ==========================================
// Core User & Player Models
// ==========================================

model User {
  id                    String       @id @default(uuid(7))
  roleId                String?      @map("role_id")
  countryId             Int?         @map("country_id")
  cityId                Int?         @map("city_id")
  username              String       @unique @map("username")
  email                 String       @unique
  isEmailVerified       Boolean      @default(false) @map("is_email_verified")
  phoneDialCode         String?      @map("phone_dial_code")
  phoneNumber           String?      @map("phone_number")
  isPhoneNumberVerified Boolean      @default(false) @map("is_phone_number_verified")
  isMfaEnabled          Boolean      @default(false) @map("is_mfa_enabled")
  status                UserStatus   @default(ACTIVE)
  isVerifiedUser        Boolean      @default(false) @map("is_verified_user")
  authProvider          AuthProvider @default(LOCAL)
  authExternalToken     String?      @db.VarChar(512)
  verifiedAt            DateTime?    @map("verified_at")
  isDeleted             Boolean      @default(false) @map("is_deleted")
  deletedAt             DateTime?    @map("deleted_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  role                   Role?                   @relation(fields: [roleId], references: [id], onDelete: SetNull)
  profile                UserProfile?
  playerProfile          PlayerProfile?
  country                Country?                @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city                   City?                   @relation("UserCity", fields: [cityId], references: [id], onDelete: SetNull)
  devices                Device[]
  userSessions           UserSession[]
  tournamentParticipants TournamentParticipant[]

  @@index([roleId])
  @@index([countryId])
  @@index([cityId])
  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid(7))
  userId      String    @unique @map("user_id")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  gender      Gender?
  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model PlayerProfile {
  id               String  @id @default(uuid(7))
  userId           String  @unique @map("user_id")
  fullName         String  @map("full_name")
  yearOfBirth      Int?    @map("year_of_birth")
  gender           Gender?
  fideId           String? @map("fide_id")
  playerFederation String? @map("player_federation") // ISO 3166-1 alpha-3 country code

  // Affiliation & Titles
  playerType  PlayerType   @default(UNRATED) @map("player_type")
  playerTitle PlayerTitle? @map("player_title")

  // Snapshot Ratings (Current Ratings)
  classicalRating Int @default(1500) @map("classical_rating")
  blitzRating     Int @default(1500) @map("blitz_rating")
  rapidRating     Int @default(1500) @map("rapid_rating")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratingSnapshots FideRatingSnapshot[]

  @@map("player_profiles")
}

// Monthly FIDE Time-Series & Rating Event Snapshots
model FideRatingSnapshot {
  id       String              @id @default(uuid(7))
  playerId String              @map("player_id")
  category TimeControlCategory

  // Event & Tournament Details
  tournamentName String @default("FIDE Rating List") @map("tournament_name")

  // Time Control Details (in seconds)
  baseTimeSeconds  Int @default(0) @map("base_time_seconds")
  incrementSeconds Int @default(0) @map("increment_seconds")

  // Rating Progression & Outcome
  ratingBefore   Int   @map("rating_before")
  ratingChange   Int   @map("rating_change")
  ratingAfter    Int   @map("rating_after")
  opponentRating Int   @map("opponent_rating")
  result         Float @default(0.0) @map("result") // 1.0 = Win, 0.5 = Draw, 0.0 = Loss

  // Date Snapshot Metadata
  snapshotYear  Int      @map("snapshot_year")
  snapshotMonth Int      @map("snapshot_month")
  recordedAt    DateTime @map("recorded_at") @db.Date

  player PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, category])
  @@index([snapshotYear, snapshotMonth])
  @@map("fide_rating_snapshots")
}

// ==========================================
// Tournament Scoped Models
// ==========================================

model Tournament {
  id          String              @id @default(uuid(7))
  name        String
  description String?
  category    TimeControlCategory
  startDate   DateTime            @map("start_date")
  endDate     DateTime?           @map("end_date")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  participants TournamentParticipant[]

  @@map("tournaments")
}

model TournamentParticipant {
  id           String         @id @default(uuid(7))
  tournamentId String         @map("tournament_id")
  userId       String         @map("user_id")
  role         TournamentRole @default(PLAYER)
  registeredAt DateTime       @default(now()) @map("registered_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId]) // يمنع تسجيل نفس المستخدم بأكثر من دور في نفس البطولة
  @@index([userId])
  @@index([tournamentId])
  @@map("tournament_participants")
}

// ==========================================
// Localization & Reference Models
// ==========================================

model Language {
  id         String            @id @default(uuid(7))
  code       String            @unique // ISO 639-1/BCP47: 'en', 'ar'
  nativeName String            @map("native_name") // 'العربية', 'English'
  isDefault  Boolean           @default(false) @map("is_default")
  isActive   Boolean           @default(true) @map("is_active")
  direction  LanguageDirection @default(LTR)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  roleTranslations       RoleTranslation[]
  permissionTranslations PermissionTranslation[]
  countryDetails         CountryTranslation[]
  cityDetails            CityTranslation[]

  @@map("languages")
}

// ==========================================
// RBAC: Roles, Permissions & Translations
// ==========================================

model Role {
  id           String   @id @default(uuid(7))
  code         String   @unique // 'SUPER_ADMIN', 'ORGANIZER', 'ARBITER', 'PLAYER'
  parentRoleId String?  @map("parent_role_id")
  isSystem     Boolean  @default(false) @map("is_system")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Self-referential parent/child hierarchy
  parentRole Role?  @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles Role[] @relation("RoleHierarchy")

  users        User[] // One Role -> Many Users
  translations RoleTranslation[]
  permissions  RolePermission[] // One Role -> Many Permissions
  devices      Device[]
  userSessions UserSession[]

  @@index([parentRoleId])
  @@index([isActive])
  @@map("roles")
}

model RoleTranslation {
  id          String   @id @default(uuid(7))
  roleId      String   @map("role_id")
  languageId  String   @map("language_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([roleId, languageId])
  @@index([languageId, roleId])
  @@map("role_translations")
}

model Permission {
  id        String   @id @default(uuid(7))
  code      String   @unique // 'USER_DELETE', 'TOURNAMENT_CREATE'
  module    String // UI grouping: 'users', 'tournaments', 'billing'
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations PermissionTranslation[]
  roles        RolePermission[]

  @@index([module])
  @@map("permissions")
}

model PermissionTranslation {
  id           String   @id @default(uuid(7))
  permissionId String   @map("permission_id")
  languageId   String   @map("language_id")
  name         String
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  language   Language   @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([permissionId, languageId])
  @@index([languageId, permissionId])
  @@map("permission_translations")
}

// Many-to-Many: Role <-> Permission
model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  grantedAt    DateTime @default(now()) @map("granted_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ═══════════════════════════════════════════════════════════════════════
// GEOGRAPHY
// ═══════════════════════════════════════════════════════════════════════

model Region {
  id         Int      @id @default(autoincrement())
  name       String
  wikiDataId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subregions SubRegion[]
  countries  Country[]

  @@map("regions")
}

model SubRegion {
  id         Int      @id @default(autoincrement())
  name       String
  regionId   Int
  wikiDataId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  region    Region    @relation(fields: [regionId], references: [id])
  countries Country[]

  @@index([regionId])
  @@map("subregions")
}

model Country {
  id              Int      @id @default(autoincrement())
  name            String
  iso3            String   @unique @db.Char(3)
  iso2            String   @unique @db.Char(2)
  numericCode     String   @db.VarChar(3)
  phoneCode       String   @db.VarChar(15)
  capital         String?
  currency        String   @db.Char(3)
  currencyName    String
  tld             String   @db.VarChar(10)
  native          String
  population      Int
  gdp             Decimal? @db.Decimal(20, 2)
  regionId        Int
  subregionId     Int?
  nationality     String
  areaSqKm        Decimal  @db.Decimal(15, 2)
  postalCodeRegex String?  @db.VarChar(255)
  timezone        Json
  emoji           String?  @db.VarChar(10)
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  region       Region               @relation(fields: [regionId], references: [id])
  subregion    SubRegion?           @relation(fields: [subregionId], references: [id])
  cities       City[]
  users        User[]
  translations CountryTranslation[]

  @@index([regionId])
  @@index([subregionId])
  @@map("countries")
}

model City {
  id          Int      @id @default(autoincrement())
  name        String
  countryId   Int
  countryName String?
  iso2        String   @db.VarChar(10)
  iso3166_2   String?  @db.VarChar(10)
  fipsCode    String?  @db.VarChar(10)
  type        String?
  level       Int      @default(1)
  parentId    Int?
  native      String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  timezone    Json?
  wikiDataId  String?
  population  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country      Country           @relation(fields: [countryId], references: [id])
  parent       City?             @relation("CityHierarchy", fields: [parentId], references: [id])
  children     City[]            @relation("CityHierarchy")
  users        User[]            @relation("UserCity")
  translations CityTranslation[]

  @@index([countryId])
  @@index([parentId])
  @@map("cities")
}

model CountryTranslation {
  id         Int    @id @default(autoincrement())
  countryId  Int
  languageId String @map("language_id")
  name       String
  nativeName String?

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@unique([countryId, languageId])
  @@index([languageId])
  @@map("country_translations")
}

model CityTranslation {
  id         Int    @id @default(autoincrement())
  cityId     Int
  languageId String @map("language_id")
  name       String

  city     City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@unique([cityId, languageId])
  @@index([languageId])
  @@map("city_translations")
}

// ═══════════════════════════════════════════════════════════════════════
// DEVICES & SESSIONS
// ═══════════════════════════════════════════════════════════════════════

model Device {
  id                 Int         @id @default(autoincrement())
  userId             String      @map("user_id")
  roleId             String?     @map("role_id")
  deviceHardware     String      @db.VarChar(255)
  userAgent          String?
  deviceType         DeviceType?
  isActive           Boolean     @default(true)
  lastLoginAt        DateTime    @default(now())
  pushToken          String?     @db.VarChar(255)
  pushTokenUpdatedAt DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role?         @relation(fields: [roleId], references: [id])
  sessions UserSession[]

  @@unique([userId, deviceHardware])
  @@index([userId])
  @@index([roleId])
  @@index([deviceHardware])
  @@map("devices")
}

model UserSession {
  id                Int                @id @default(autoincrement())
  userId            String             @map("user_id")
  deviceId          Int                @map("device_id")
  roleId            String?            @map("role_id")
  deviceName        String?
  deviceFingerPrint String             @db.VarChar(255)
  ipAddress         String?            @db.VarChar(45)
  locationCity      String?
  locationCountry   String?            @db.VarChar(2)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  lastActiveAt      DateTime           @default(now())
  expiredAt         DateTime
  terminatedAt      DateTime?
  terminationReason TerminationReason?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id])

  @@index([userId])
  @@index([deviceId])
  @@index([roleId])
  @@map("user_sessions")
}